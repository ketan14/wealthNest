FROM rust:1-bookworm

# Install Node.js 20 & WebKitGTK dependencies for Tauri 2 Linux builds
RUN apt-get update && apt-get install -y \
    curl \
    wget \
    file \
    build-essential \
    libwebkit2gtk-4.1-dev \
    libgtk-3-dev \
    libayatana-appindicator3-dev \
    librsvg2-dev \
    libssl-dev \
    libsqlite3-dev \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Pre-install global Tauri CLI
RUN npm install -g @tauri-apps/cli@^2

# Set Cargo target directory within workspace
ENV CARGO_TARGET_DIR=/app/src-tauri/target

# Default build command: compile frontend and generate Debian and AppImage bundles
CMD ["tauri", "build", "--bundles", "deb"]
