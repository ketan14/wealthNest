{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WealthNest",
  "version": "0.1.0",
  "identifier": "in.wealthnest.app",
  "build": {
    "beforeDevCommand": "npm run dev --workspace=@wealthnest/web",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build --workspace=@wealthnest/web",
    "frontendDist": "../apps/web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "WealthNest — Personal Wealth & Asset Management",
        "width": 1280,
        "height": 800,
        "minWidth": 360,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Finance",
    "shortDescription": "Institutional-Grade Personal Wealth & Asset Operating System",
    "longDescription": "Personal wealth and asset management application with India-first taxation (LTCG Sec 112A), local-first SQLite persistence, and zero floating-point drift.",
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0 | libwebkit2gtk-4.0-37", "libsqlite3-0"]
      }
    }
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:wealthnest_v1.db"]
    }
  }
}
