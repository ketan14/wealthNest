# WealthNest Environment Variables Example
# Copy this file to .env or .env.local for local customization

# Application metadata
VITE_APP_NAME=WealthNest
VITE_APP_ENV=development

# Network Ports
VITE_DEV_PORT=5174
PROXY_PORT=30000

# Local domain host configuration
VITE_APP_HOST=localhost

# Supabase (Phase 1+ - Not required for initial scaffold)
# VITE_SUPABASE_URL=http://localhost:54321
# VITE_SUPABASE_ANON_KEY=
